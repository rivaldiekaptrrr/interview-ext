{
  "manifest_version": 3,
  "name": "AI Interview Copilot",
  "version": "1.0.4",
  "description": "Asisten wawancara real-time cerdas yang mendengarkan pertanyaan interviewer dan memberikan poin jawaban terstruktur secara instan.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "AI Interview Copilot"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "scripts": ["background/service-worker.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "http://localhost/*",
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "toggle-widget": {
      "suggested_key": {
        "default": "Alt+H"
      },
      "description": "Toggle visibility of the interview copilot widget (Boss Key)"
    },
    "answer-now": {
      "suggested_key": {
        "default": "Alt+J"
      },
      "description": "Trigger AI to answer the current question immediately"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["content/content.css", "icons/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-interview-copilot@rivaldi.dev",
      "strict_min_version": "109.0"
    }
  }
}
